'use client';
import Shell from '@/components/Shell';
import { api, API_URL, labelPdfUrl } from '@/lib/api';
import type { ProjectDetailOut, ExpectedItemOut } from '@/types';
import { useParams } from 'next/navigation';
import { useEffect, useMemo, useState } from 'react';

export default function ProjectDetailPage(){
 const {id}=useParams<{id:string}>(); const [project,setProject]=useState<ProjectDetailOut|null>(null); const [error,setError]=useState(''); const [created,setCreated]=useState('');
 const [form,setForm]=useState({label_text:'',title:'',box_number:'1',total_boxes:'1',warehouse:'ASTANA',contents_text:'',comment:''});
 const [contents,setContents]=useState<Record<string, number>>({});
 async function load(){ try{setProject(await api.project(id));}catch(e){setError(e instanceof Error?e.message:'Ошибка')}}
 useEffect(()=>{load()},[id]);
 const selected = useMemo(()=>project?.expected_items.filter(i=>(contents[i.id]||0)>0)||[],[project,contents]);
 async function createBox(){ if(!project)return; setError(''); setCreated(''); try{const box=await api.createBox({project_id:project.id,label_text:form.label_text||`${project.project_code}/${form.title}`,title:form.title||null,box_number:Number(form.box_number||1),total_boxes:Number(form.total_boxes||1),warehouse:form.warehouse,current_location:form.warehouse,contents_text:form.contents_text||null,comment:form.comment||null,contents:selected.map(i=>({expected_item_id:i.id,name:i.name,quantity:contents[i.id],unit:i.unit||'шт'}))}); setCreated(`Создана коробка ${box.box_code}`); window.open(labelPdfUrl(box.box_code),'_blank'); setContents({}); await load();}catch(e){setError(e instanceof Error?e.message:'Ошибка')}}
 if(!project) return <Shell><div className="help">Загрузка...</div></Shell>;
 return <Shell><div className="top"><div><h1 className="h1">{project.project_code}</h1><p className="help">{project.name||'Проект'} · {project.warehouse||'склад не указан'}</p></div></div>{error&&<div className="error">{error}</div>}{created&&<div className="success">{created}</div>}<div className="grid grid-2"><section className="card"><h2>Товары из 1С</h2><table className="table"><thead><tr><th>Товар</th><th>Кол-во</th><th>В коробку</th></tr></thead><tbody>{project.expected_items.map((i:ExpectedItemOut)=><tr key={i.id}><td>{i.name}<br/><span className="help">{i.document_number||''}</span></td><td>{i.quantity} {i.unit||'шт'}</td><td><input className="input" type="number" min="0" max={i.quantity} value={contents[i.id]||''} onChange={e=>setContents({...contents,[i.id]:Number(e.target.value||0)})}/></td></tr>)}</tbody></table></section><section className="card"><h2>Создать коробку</h2><div className="grid grid-2"><div className="field"><label>Название</label><input className="input" value={form.title} onChange={e=>setForm({...form,title:e.target.value})} placeholder="Панель / БР / П"/></div><div className="field"><label>Надпись</label><input className="input" value={form.label_text} onChange={e=>setForm({...form,label_text:e.target.value})} placeholder="55/11/ЦОССУ/Панель/БР/П"/></div><div className="field"><label>Номер</label><input className="input" value={form.box_number} onChange={e=>setForm({...form,box_number:e.target.value})}/></div><div className="field"><label>Всего коробок</label><input className="input" value={form.total_boxes} onChange={e=>setForm({...form,total_boxes:e.target.value})}/></div></div><div className="field"><label>Что внутри текстом</label><textarea value={form.contents_text} onChange={e=>setForm({...form,contents_text:e.target.value})} placeholder="Панель 1, пульт 1, кабель 1"/></div><div className="field"><label>Комментарий</label><textarea value={form.comment} onChange={e=>setForm({...form,comment:e.target.value})} placeholder="Ножки отдельно в коробке 2/2"/></div><button className="btn black" onClick={createBox}>Создать и напечатать QR/Barcode</button></section></div><section className="card" style={{marginTop:18}}><h2>Коробки проекта</h2><table className="table"><thead><tr><th>Код</th><th>Надпись</th><th>Коробка</th><th>Статус</th><th>Печать</th></tr></thead><tbody>{project.boxes.map(b=><tr key={b.id}><td className="mono">{b.box_code}</td><td>{b.label_text}<br/><span className="help">{b.contents_text||b.contents.map(c=>`${c.name} — ${c.quantity}`).join(', ')}</span></td><td>{b.box_number}/{b.total_boxes}</td><td><span className="badge">{b.status}</span></td><td><a className="btn ghost" href={labelPdfUrl(b.box_code)} target="_blank">PDF</a></td></tr>)}</tbody></table></section></Shell>
}
